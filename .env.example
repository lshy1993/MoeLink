# ── MoeLink 前端环境变量 ─────────────────────────────
# 复制为 .env.local 后填值（.env.local 不会提交到仓库）

# PrimeUI 授权密钥（PrimeVue 5+ 必需）
#   - 免费 Community 授权（个人 / 学生 / <5 开发者的小组织）：https://primeui.store/primeui
#   - 商业授权：https://primeui.dev/pricing
# 留空则应用可运行，但控制台/界面会出现授权提示
VITE_PRIMEUI_LICENSE_KEY=

# 测试站（genshin quiz）地址，留空则使用 https://quiz.moelink.site
# VITE_QUIZ_URL=http://localhost:3000
